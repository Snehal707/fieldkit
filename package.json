{
  "name": "fieldkit",
  "version": "0.1.9",
  "private": true,
  "description": "FieldKit: offline field workflows for Hermes Agent (PWA + dashboard tab)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build:app && npm run build:dashboard",
    "build:app": "vite build --config app/vite.config.ts && node scripts/postbuild-app.mjs",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "dev": "vite --config app/vite.config.ts",
    "typecheck": "tsc -p app/tsconfig.json --noEmit && tsc -p dashboard/tsconfig.json --noEmit",
    "test": "vitest run --config app/vitest.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "idb": "8.0.4",
    "minisearch": "7.2.0",
    "qrcode-generator": "2.0.4",
    "tesseract.js": "7.0.0",
    "wasm-feature-detect": "1.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "18.3.12",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
