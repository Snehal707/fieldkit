{
  "description": "Condition AST vectors shared by fieldkit_core/engine.py and app/src/engine.ts",
  "cases": [
    {"name": "eq string", "cond": {"op": "eq", "field": "a", "value": "x"}, "answers": {"a": "x"}, "expected": true},
    {"name": "eq numeric string vs number", "cond": {"op": "eq", "field": "a", "value": 5}, "answers": {"a": "5"}, "expected": true},
    {"name": "eq missing", "cond": {"op": "eq", "field": "a", "value": "x"}, "answers": {}, "expected": false},
    {"name": "neq missing", "cond": {"op": "neq", "field": "a", "value": "x"}, "answers": {}, "expected": true},
    {"name": "eq bool false", "cond": {"op": "eq", "field": "a", "value": false}, "answers": {"a": false}, "expected": true},
    {"name": "eq bool not number", "cond": {"op": "eq", "field": "a", "value": 0}, "answers": {"a": false}, "expected": false},
    {"name": "gt", "cond": {"op": "gt", "field": "n", "value": 7.1}, "answers": {"n": 9}, "expected": true},
    {"name": "gt equal", "cond": {"op": "gt", "field": "n", "value": 7}, "answers": {"n": 7}, "expected": false},
    {"name": "gte equal", "cond": {"op": "gte", "field": "n", "value": 7}, "answers": {"n": 7}, "expected": true},
    {"name": "lt string number", "cond": {"op": "lt", "field": "n", "value": 10}, "answers": {"n": "3"}, "expected": true},
    {"name": "lt missing", "cond": {"op": "lt", "field": "n", "value": 10}, "answers": {}, "expected": false},
    {"name": "lte non numeric", "cond": {"op": "lte", "field": "n", "value": 10}, "answers": {"n": "abc"}, "expected": false},
    {"name": "date compare", "cond": {"op": "lt", "field": "d", "value": "2026-01-01"}, "answers": {"d": "2025-12-31"}, "expected": true},
    {"name": "compare on list is false", "cond": {"op": "gt", "field": "l", "value": 1}, "answers": {"l": [5]}, "expected": false},
    {"name": "in", "cond": {"op": "in", "field": "a", "value": ["x", "y"]}, "answers": {"a": "y"}, "expected": true},
    {"name": "in miss", "cond": {"op": "in", "field": "a", "value": ["x", "y"]}, "answers": {"a": "z"}, "expected": false},
    {"name": "contains list", "cond": {"op": "contains", "field": "s", "value": "vibration"}, "answers": {"s": ["noise", "vibration"]}, "expected": true},
    {"name": "contains list miss", "cond": {"op": "contains", "field": "s", "value": "heat"}, "answers": {"s": ["noise"]}, "expected": false},
    {"name": "contains substring case-insensitive", "cond": {"op": "contains", "field": "t", "value": "Grind"}, "answers": {"t": "a grinding sound"}, "expected": true},
    {"name": "contains on missing", "cond": {"op": "contains", "field": "t", "value": "x"}, "answers": {}, "expected": false},
    {"name": "exists", "cond": {"op": "exists", "field": "a"}, "answers": {"a": 0}, "expected": true},
    {"name": "exists empty string", "cond": {"op": "exists", "field": "a"}, "answers": {"a": ""}, "expected": false},
    {"name": "exists empty list", "cond": {"op": "exists", "field": "a"}, "answers": {"a": []}, "expected": false},
    {"name": "exists false bool", "cond": {"op": "exists", "field": "a"}, "answers": {"a": false}, "expected": true},
    {"name": "empty", "cond": {"op": "empty", "field": "a"}, "answers": {}, "expected": true},
    {"name": "and", "cond": {"op": "and", "all": [{"op": "eq", "field": "a", "value": 1}, {"op": "eq", "field": "b", "value": 2}]}, "answers": {"a": 1, "b": 2}, "expected": true},
    {"name": "and partial", "cond": {"op": "and", "all": [{"op": "eq", "field": "a", "value": 1}, {"op": "eq", "field": "b", "value": 2}]}, "answers": {"a": 1}, "expected": false},
    {"name": "and empty", "cond": {"op": "and", "all": []}, "answers": {}, "expected": true},
    {"name": "or", "cond": {"op": "or", "any": [{"op": "eq", "field": "a", "value": 1}, {"op": "eq", "field": "b", "value": 2}]}, "answers": {"b": 2}, "expected": true},
    {"name": "or empty", "cond": {"op": "or", "any": []}, "answers": {}, "expected": false},
    {"name": "not", "cond": {"op": "not", "cond": {"op": "exists", "field": "a"}}, "answers": {}, "expected": true},
    {"name": "always", "cond": {"op": "always"}, "answers": {}, "expected": true},
    {"name": "null condition", "cond": null, "answers": {}, "expected": true},
    {"name": "unknown op fails closed", "cond": {"op": "eval", "field": "a"}, "answers": {"a": 1}, "expected": false}
  ]
}
