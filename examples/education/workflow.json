{
  "id": "classroom-observation",
  "version": 1,
  "status": "published",
  "title": {"en": "Classroom observation", "hi": "कक्षा अवलोकन"},
  "description": {"en": "Observe a science lesson, record student understanding and learning resources.", "hi": "विज्ञान पाठ का अवलोकन करें, छात्रों की समझ और शिक्षण संसाधन दर्ज करें।"},
  "domain": "education",
  "languages": ["en", "hi"],
  "default_language": "en",
  "knowledge_packs": ["science-basics"],
  "dictionary_packs": ["science-terms"],
  "fields": [
    {"id": "school", "type": "text", "label": {"en": "School name", "hi": "विद्यालय का नाम"}, "required": true, "validation": {"min_length": 2, "max_length": 120}},
    {"id": "grade", "type": "single_choice", "label": {"en": "Grade", "hi": "कक्षा"}, "required": true,
     "options": [{"value": "6", "label": "6"}, {"value": "7", "label": "7"}, {"value": "8", "label": "8"}, {"value": "9", "label": "9"}, {"value": "10", "label": "10"}]},
    {"id": "topic", "type": "single_choice", "label": {"en": "Lesson topic", "hi": "पाठ का विषय"}, "required": true,
     "options": [
       {"value": "photosynthesis", "label": {"en": "Photosynthesis", "hi": "प्रकाश संश्लेषण"}},
       {"value": "water_cycle", "label": {"en": "Water cycle", "hi": "जल चक्र"}},
       {"value": "electric_circuits", "label": {"en": "Electric circuits", "hi": "विद्युत परिपथ"}},
       {"value": "other", "label": {"en": "Other", "hi": "अन्य"}}
     ], "knowledge_query": "lesson topic explanation"},
    {"id": "topic_other", "type": "text", "label": {"en": "Other topic", "hi": "अन्य विषय"},
     "visible_if": {"op": "eq", "field": "topic", "value": "other"}, "required_if": {"op": "eq", "field": "topic", "value": "other"}},
    {"id": "lesson_time", "type": "time", "label": {"en": "Lesson start time", "hi": "पाठ आरंभ समय"}},
    {"id": "students_present", "type": "number", "label": {"en": "Students present", "hi": "उपस्थित छात्र"}, "required": true, "validation": {"min": 0, "max": 200, "integer": true}},
    {"id": "students_correct", "type": "number", "label": {"en": "Students answering the check question correctly", "hi": "जाँच प्रश्न का सही उत्तर देने वाले छात्र"},
     "validation": {"min": 0, "max": 200, "integer": true}},
    {"id": "practical", "type": "checkbox", "label": {"en": "A hands-on activity was used", "hi": "व्यावहारिक गतिविधि का उपयोग हुआ"}},
    {"id": "practical_desc", "type": "multiline", "label": {"en": "Describe the activity", "hi": "गतिविधि का वर्णन करें"},
     "visible_if": {"op": "eq", "field": "practical", "value": true}},
    {"id": "resources", "type": "multi_choice", "label": {"en": "Resources available", "hi": "उपलब्ध संसाधन"},
     "options": [
       {"value": "textbook", "label": {"en": "Textbooks", "hi": "पाठ्यपुस्तकें"}},
       {"value": "lab", "label": {"en": "Lab equipment", "hi": "प्रयोगशाला उपकरण"}},
       {"value": "board", "label": {"en": "Blackboard", "hi": "श्यामपट"}},
       {"value": "digital", "label": {"en": "Digital device", "hi": "डिजिटल उपकरण"}}
     ], "validation": {"min_items": 1}},
    {"id": "misconceptions", "type": "multiline", "label": {"en": "Misconceptions heard", "hi": "सुनी गई गलत धारणाएँ"},
     "help": {"en": "Write what students said in their own words.", "hi": "छात्रों ने अपने शब्दों में जो कहा वह लिखें।"}},
    {"id": "board_photo", "type": "photo", "label": {"en": "Photo of the board (OCR available)", "hi": "श्यामपट की तस्वीर (OCR उपलब्ध)"}},
    {"id": "observer_sign", "type": "signature", "label": {"en": "Observer signature", "hi": "पर्यवेक्षक के हस्ताक्षर"}}
  ],
  "classification": {
    "rules": [
      {"id": "low_attendance", "label": {"en": "Low attendance", "hi": "कम उपस्थिति"}, "severity": "medium",
       "when": {"op": "lt", "field": "students_present", "value": 10}},
      {"id": "no_practical", "label": {"en": "No hands-on activity", "hi": "कोई व्यावहारिक गतिविधि नहीं"}, "severity": "low",
       "when": {"op": "neq", "field": "practical", "value": true},
       "finding": {"en": "Consider a simple demonstration next lesson.", "hi": "अगले पाठ में एक सरल प्रदर्शन पर विचार करें।"}}
    ],
    "keywords": [
      {"id": "photosynthesis_misconception", "label": {"en": "Common photosynthesis misconception", "hi": "प्रकाश संश्लेषण की सामान्य गलत धारणा"}, "severity": "medium",
       "fields": ["misconceptions"], "keywords": ["food from soil", "plants eat soil", "breathe in oxygen", "only at night"]}
    ],
    "scores": [
      {"id": "engagement", "label": {"en": "Engagement score", "hi": "सहभागिता अंक"},
       "items": [
         {"when": {"op": "eq", "field": "practical", "value": true}, "points": 2},
         {"when": {"op": "contains", "field": "resources", "value": "lab"}, "points": 1},
         {"when": {"op": "contains", "field": "resources", "value": "digital"}, "points": 1}
       ],
       "bands": [
         {"min": 0, "label": {"en": "Low", "hi": "कम"}, "severity": "medium"},
         {"min": 2, "label": {"en": "Good", "hi": "अच्छा"}, "severity": "low"}
       ]}
    ]
  }
}
