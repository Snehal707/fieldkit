{
  "id": "equipment-inspection",
  "version": 2,
  "status": "published",
  "title": {"en": "Equipment inspection", "hi": "उपकरण निरीक्षण"},
  "description": {"en": "Routine inspection of rotating equipment with troubleshooting guidance and photographs.", "hi": "समस्या निवारण मार्गदर्शन और तस्वीरों के साथ घूमने वाले उपकरणों का नियमित निरीक्षण।"},
  "domain": "maintenance",
  "languages": ["en", "hi"],
  "default_language": "en",
  "knowledge_packs": ["maintenance-basics"],
  "dictionary_packs": ["maintenance-terms"],
  "review_required": true,
  "analysis_instructions": "Assess whether the equipment can stay in service. Flag any safety concern for human review.",
  "fields": [
    {"id": "intro", "type": "instruction", "label": {"en": "Isolate and lock out the machine before touching moving parts.", "hi": "चलते हुए हिस्सों को छूने से पहले मशीन को अलग करें और लॉक आउट करें।"}},
    {"id": "asset_id", "type": "text", "label": {"en": "Asset tag", "hi": "एसेट टैग"}, "required": true,
     "validation": {"pattern": "[A-Z]{2,4}-[0-9]{3,6}"}, "placeholder": "PMP-0042", "help": {"en": "Format: letters, dash, digits (e.g. PMP-0042).", "hi": "प्रारूप: अक्षर, डैश, अंक (जैसे PMP-0042)।"}},
    {"id": "inspection_date", "type": "date", "label": {"en": "Inspection date", "hi": "निरीक्षण तिथि"}, "required": true},
    {"id": "running_hours", "type": "number", "label": {"en": "Running hours", "hi": "चलने के घंटे"}, "unit": "h", "validation": {"min": 0, "max": 200000, "integer": true}},
    {"id": "condition", "type": "single_choice", "label": {"en": "Overall condition", "hi": "समग्र स्थिति"}, "required": true,
     "options": [
       {"value": "good", "label": {"en": "Good", "hi": "अच्छी"}},
       {"value": "fair", "label": {"en": "Fair", "hi": "ठीक"}},
       {"value": "poor", "label": {"en": "Poor", "hi": "खराब"}}
     ]},
    {"id": "symptoms", "type": "multi_choice", "label": {"en": "Observed symptoms", "hi": "देखे गए लक्षण"},
     "options": [
       {"value": "vibration", "label": {"en": "Abnormal vibration", "hi": "असामान्य कंपन"}},
       {"value": "noise", "label": {"en": "Unusual noise", "hi": "असामान्य आवाज़"}},
       {"value": "heat", "label": {"en": "Overheating", "hi": "अधिक गर्म होना"}},
       {"value": "leak", "label": {"en": "Fluid leak", "hi": "तरल रिसाव"}}
     ]},
    {"id": "vibration_level", "type": "number", "label": {"en": "Vibration velocity", "hi": "कंपन वेग"}, "unit": "mm/s",
     "visible_if": {"op": "contains", "field": "symptoms", "value": "vibration"},
     "required_if": {"op": "contains", "field": "symptoms", "value": "vibration"},
     "validation": {"min": 0, "max": 100}, "explain_topic": "vibration", "knowledge_query": "causes of equipment vibration"},
    {"id": "bearing_temp", "type": "number", "label": {"en": "Bearing temperature", "hi": "बेयरिंग तापमान"}, "unit": "°C",
     "visible_if": {"op": "contains", "field": "symptoms", "value": "heat"}, "validation": {"min": -40, "max": 250},
     "knowledge_query": "bearing overheating"},
    {"id": "leak_fluid", "type": "single_choice", "label": {"en": "Leaking fluid", "hi": "रिसने वाला तरल"},
     "visible_if": {"op": "contains", "field": "symptoms", "value": "leak"},
     "options": [
       {"value": "oil", "label": {"en": "Oil", "hi": "तेल"}},
       {"value": "water", "label": {"en": "Water / coolant", "hi": "पानी / कूलेंट"}},
       {"value": "unknown", "label": {"en": "Unknown", "hi": "अज्ञात"}}
     ]},
    {"id": "guard_ok", "type": "checkbox", "label": {"en": "Safety guards are fitted and intact", "hi": "सुरक्षा गार्ड लगे हुए और सही हैं"}, "required": true},
    {"id": "notes", "type": "multiline", "label": {"en": "Notes", "hi": "टिप्पणियाँ"}, "validation": {"max_length": 4000},
     "required_if": {"op": "eq", "field": "condition", "value": "poor"},
     "help": {"en": "Describe what you saw, heard or measured.", "hi": "आपने जो देखा, सुना या मापा उसका वर्णन करें।"}},
    {"id": "photos", "type": "photo", "label": {"en": "Photographs", "hi": "तस्वीरें"}, "validation": {"max_items": 6},
     "required_if": {"op": "eq", "field": "condition", "value": "poor"}},
    {"id": "voice_note", "type": "audio", "label": {"en": "Voice note", "hi": "वॉइस नोट"}},
    {"id": "location", "type": "gps", "label": {"en": "Location", "hi": "स्थान"}, "validation": {"max_accuracy_m": 100}},
    {"id": "inspector_sign", "type": "signature", "label": {"en": "Inspector signature", "hi": "निरीक्षक के हस्ताक्षर"}}
  ],
  "classification": {
    "rules": [
      {"id": "guard_missing", "label": {"en": "Safety guard problem", "hi": "सुरक्षा गार्ड समस्या"}, "severity": "critical",
       "when": {"op": "eq", "field": "guard_ok", "value": false},
       "finding": {"en": "Do not run the machine until guards are restored.", "hi": "गार्ड ठीक होने तक मशीन न चलाएँ।"}},
      {"id": "vibration_high", "label": {"en": "Vibration above alarm level", "hi": "कंपन अलार्म स्तर से ऊपर"}, "severity": "high",
       "when": {"op": "gt", "field": "vibration_level", "value": 7.1},
       "finding": {"en": "Velocity above 7.1 mm/s is commonly treated as unacceptable for medium machines. Check alignment, balance and bearings.", "hi": "मध्यम मशीनों के लिए 7.1 mm/s से अधिक वेग आम तौर पर अस्वीकार्य माना जाता है। संरेखण, संतुलन और बेयरिंग जाँचें।"}},
      {"id": "bearing_hot", "label": {"en": "Hot bearing", "hi": "गर्म बेयरिंग"}, "severity": "high",
       "when": {"op": "gte", "field": "bearing_temp", "value": 80},
       "finding": {"en": "Bearing at or above 80 °C. Check lubrication and load.", "hi": "बेयरिंग 80 °C या अधिक। स्नेहन और भार जाँचें।"}}
    ],
    "keywords": [
      {"id": "noise_terms", "label": {"en": "Bearing wear indicators in notes", "hi": "टिप्पणियों में बेयरिंग घिसाव संकेत"}, "severity": "medium",
       "fields": ["notes", "voice_note"], "keywords": ["grinding", "squeal", "knocking", "rumble", "clicking"]},
      {"id": "corrosion_leak_terms", "label": {"en": "Corrosion or leak reported", "hi": "जंग या रिसाव की सूचना"}, "severity": "medium",
       "fields": ["notes", "voice_note", "photos"], "keywords": ["rust", "corrosion", "corroded", "leak", "leaking", "seep", "drip", "pooling", "जंग", "रिसाव", "लीक", "टपक"]}
    ],
    "scores": [
      {"id": "risk", "label": {"en": "Risk score", "hi": "जोखिम अंक"},
       "items": [
         {"when": {"op": "eq", "field": "condition", "value": "poor"}, "points": 3},
         {"when": {"op": "eq", "field": "condition", "value": "fair"}, "points": 1},
         {"when": {"op": "contains", "field": "symptoms", "value": "vibration"}, "points": 2},
         {"when": {"op": "contains", "field": "symptoms", "value": "heat"}, "points": 2},
         {"when": {"op": "or", "any": [{"op": "contains", "field": "symptoms", "value": "leak"}, {"op": "contains", "field": "notes", "value": "leak"}, {"op": "contains", "field": "notes", "value": "रिसाव"}]}, "points": 2},
         {"when": {"op": "eq", "field": "leak_fluid", "value": "oil"}, "points": 1},
         {"when": {"op": "or", "any": [{"op": "contains", "field": "notes", "value": "rust"}, {"op": "contains", "field": "notes", "value": "corro"}, {"op": "contains", "field": "notes", "value": "जंग"}]}, "points": 2},
         {"when": {"op": "eq", "field": "guard_ok", "value": false}, "points": 5}
       ],
       "bands": [
         {"min": 0, "label": {"en": "Low risk", "hi": "कम जोखिम"}, "severity": "low"},
         {"min": 3, "label": {"en": "Medium risk", "hi": "मध्यम जोखिम"}, "severity": "medium"},
         {"min": 6, "label": {"en": "High risk", "hi": "उच्च जोखिम"}, "severity": "high"}
       ]}
    ],
    "decision_trees": [
      {"id": "service_action", "label": {"en": "Recommended action", "hi": "अनुशंसित कार्रवाई"},
       "root": {"if": {"op": "eq", "field": "guard_ok", "value": false},
                "then": {"result": {"label": {"en": "Stop and tag out", "hi": "रोकें और टैग आउट करें"}, "severity": "critical"}},
                "else": {"if": {"op": "eq", "field": "condition", "value": "poor"},
                         "then": {"result": {"label": {"en": "Schedule repair this week", "hi": "इस सप्ताह मरम्मत तय करें"}, "severity": "high"}},
                         "else": {"if": {"op": "or", "any": [{"op": "or", "any": [{"op": "contains", "field": "symptoms", "value": "leak"}, {"op": "contains", "field": "notes", "value": "leak"}, {"op": "contains", "field": "notes", "value": "रिसाव"}]}, {"op": "or", "any": [{"op": "contains", "field": "notes", "value": "rust"}, {"op": "contains", "field": "notes", "value": "corro"}, {"op": "contains", "field": "notes", "value": "जंग"}]}, {"op": "gt", "field": "vibration_level", "value": 7.1}, {"op": "gte", "field": "bearing_temp", "value": 80}]},
                                  "then": {"result": {"label": {"en": "Repair within 7 days and re-inspect", "hi": "7 दिनों में मरम्मत करें और दोबारा जाँचें"}, "severity": "medium"}},
                                  "else": {"result": {"label": {"en": "Continue routine monitoring", "hi": "नियमित निगरानी जारी रखें"}, "severity": "low"}}}}}}
    ]
  }
}
